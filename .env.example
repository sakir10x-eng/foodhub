# ─────────────────────────────────────────────────────────────── core ───
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER@127.0.0.1:5432/foodhub?schema=public"

# Apex domain for vendor subdomains (<slug>.PLATFORM_DOMAIN) and the marketplace host.
# lvh.me resolves *.lvh.me -> 127.0.0.1, so subdomain routing works locally with no /etc/hosts edits.
PLATFORM_DOMAIN=lvh.me:3000
MARKETPLACE_HOST=lvh.me:3000
# What vendors point their CNAME at.
CNAME_TARGET=edge.foodhub.com.bd
CORS_ORIGINS=http://lvh.me:3000,http://lvh.me:3001

# ────────────────────────────────────────────────────────────── secrets ───
# 32-byte hex. Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production
# Encrypts each vendor's own gateway credentials at rest (AES-256-GCM).
ENCRYPTION_KEY=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ─────────────────────────────────────────────────── cache + queue ───
# Leave empty to run the in-process queue/cache driver (dev, no Redis needed).
# Set it in production — BullMQ takes over automatically.
REDIS_URL=

# ───────────────────────────────────────────────────────────── media ───
MEDIA_DRIVER=local
MEDIA_DIR=storage/media
MEDIA_PUBLIC_BASE=/media
CDN_BASE=
MAX_UPLOAD_BYTES=8388608

# ─────────────────────────────────────────────────────── marketplace ───
DEFAULT_COMMISSION_BPS=1500
GATEWAY_FEE_BPS=250
NEAR_ME_RADIUS_KM=8
SETTLEMENT_CRON=0 3 * * 1
BILLING_CRON=0 2 * * *
BILLING_GRACE_DAYS=7

# ──────────────────────────────────────────────────────────── payment ───
# OUR marketplace gateway (Mode B). Vendors' own keys are stored encrypted per tenant.
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true
# Split-payout routes the vendor's share directly from the gateway, so we never hold
# customer funds — this is what keeps Mode B outside PSP/escrow licensing.
SSLCZ_SPLIT_PAYOUT=true
PAYMENT_SUCCESS_URL=http://lvh.me:3000/order
PAYMENT_FAIL_URL=http://lvh.me:3000/checkout?failed=1

# ──────────────────────────────────────────────────────── web clients ───
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_MARKETPLACE_HOST=lvh.me:3000
NEXT_PUBLIC_PLATFORM_DOMAIN=lvh.me:3000

# ══════════════════════════════════════════════ Phase 3 — scale & ops ═══
# Structured JSON logs (forced on when NODE_ENV=production).
LOG_FORMAT=pretty
# Queries slower than this are logged and counted as a metric.
SLOW_QUERY_MS=300
# Error reporting. Optional: install @sentry/node and set a DSN to enable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
GIT_SHA=

# Read replica for analytics and marketplace browsing. Unset = use the primary.
REPLICA_DATABASE_URL=
# Behind PgBouncer in transaction mode, Prisma needs these flags on the URL:
#   ...?pgbouncer=true&connection_limit=1

# Abuse protection. The tenant ceiling is the noisy-neighbour lever.
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_TENANT_PER_MINUTE=1200
RATE_LIMIT_DISABLED=0

# ═══════════════════════════════════════════ Phase 4 — moat features ═══
# AI ordering assistant. Without a key the feature reports itself unavailable
# and the storefront simply doesn't render the chat bubble.
ANTHROPIC_API_KEY=

# WhatsApp Business intake (optional). WHATSAPP_APP_SECRET is REQUIRED for the
# webhook to accept anything — unsigned payloads are refused, not trusted.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TENANT_SLUG=

# Nightly rebuild of "ordered together" recommendation counts.
AFFINITY_CRON=30 3 * * *
