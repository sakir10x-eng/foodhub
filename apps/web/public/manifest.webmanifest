{
  "name": "FoodHub",
  "short_name": "FoodHub",
  "description": "Order food from restaurants near you.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
